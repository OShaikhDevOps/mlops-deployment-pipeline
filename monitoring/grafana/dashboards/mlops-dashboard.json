{
  "dashboard": {
    "id": null,
    "title": "ML Model Monitoring",
    "panels": [
      {
        "type": "graph",
        "title": "Prediction Requests",
        "targets": [
          { "expr": "prediction_requests_total", "legendFormat": "requests" }
